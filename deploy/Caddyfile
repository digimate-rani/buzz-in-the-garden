# Replace game.example.com with your domain (its DNS must point to this server).
# Caddy gets and renews the HTTPS certificate by itself.
# Copy to /etc/caddy/Caddyfile and run: sudo systemctl reload caddy

game.example.com {
	root * /var/www/buzz
	encode zstd gzip

	# Phones must always re-check these, otherwise game updates never arrive.
	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"

	header /fonts/* Cache-Control "public, max-age=31536000, immutable"
	header /manifest.webmanifest Content-Type "application/manifest+json"

	file_server
}
